{
  "name": "envseal-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:portability",
    "test:portability": "vitest run --config vitest.config.ts",
    "test:zero-leak": "pnpm --filter @envseal/mcp-server test -- zero-leak",
    "lint": "eslint .",
    "clean": "pnpm -r exec rm -rf dist tsconfig.tsbuildinfo",
    "gauntlet": "agent-validate run",
    "gauntlet:skip": "agent-validate skip",
    "gauntlet:install": "node scripts/install-gauntlet-hook.mjs",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^2.1.8"
  }
}
