{
  "name": "@envseal/mcp-server",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "envseal-mcp": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/release-guard.mjs",
    "build": "tsc -p tsconfig.json && pnpm gen:dialects",
    "gen:dialects": "tsx scripts/gen-dialects.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@envseal/protocol": "workspace:*",
    "@envseal/core": "workspace:*",
    "@envseal/prompters": "workspace:*",
    "@envseal/registry": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.13.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "zod-to-json-schema": "^3.24.1"
  }
}
