{
  "name": "@envseal/protocol",
  "version": "0.1.1",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/release-guard.mjs",
    "build": "tsc -p tsconfig.json && pnpm gen:schemas",
    "gen:schemas": "tsx scripts/gen-schemas.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "zod-to-json-schema": "^3.24.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NDilanka/envseal.git",
    "directory": "protocol/package.json"
  },
  "homepage": "https://github.com/NDilanka/envseal#readme",
  "bugs": {
    "url": "https://github.com/NDilanka/envseal/issues"
  }
}
