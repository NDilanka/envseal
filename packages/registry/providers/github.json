{
  "id": "github",
  "name": "GitHub",
  "category": "vcs",
  "keys": [
    {
      "envVar": "GITHUB_TOKEN",
      "description": "Personal access token for GitHub API",
      "format": {
        "pattern": "^(ghp_|github_pat_)[A-Za-z0-9_]{36,256}$",
        "prefix": "ghp_",
        "minLength": 36,
        "example": "ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
      },
      "signupUrl": "https://github.com/settings/tokens",
      "docsUrl": "https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/creating-a-personal-access-token",
      "rotateUrl": "https://github.com/settings/tokens",
      "verify": {
        "method": "GET",
        "url": "https://api.github.com/user",
        "headerTemplate": {
          "Authorization": "Bearer {{value}}"
        },
        "expectStatus": [200]
      }
    }
  ]
}
