{
  "name": "@envseal/sdk",
  "version": "0.1.1",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/release-guard.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@envseal/protocol": "workspace:*",
    "@envseal/core": "workspace:*",
    "@envseal/prompters": "workspace:*",
    "@envseal/registry": "workspace:*",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
