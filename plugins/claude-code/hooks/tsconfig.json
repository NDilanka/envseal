{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "rootDir": ".",
    "noEmit": true
  },
  "include": [
    "./**/*.ts"
  ],
  "exclude": [
    "dist"
  ]
}
