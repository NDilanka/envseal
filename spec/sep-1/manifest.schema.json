{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://envseal.dev/spec/sep-1/manifest.schema.json",
  "title": "EnvSeal SEP/1 manifest",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "description": {
            "type": "string",
            "maxLength": 280
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "secret": {
            "type": "boolean",
            "default": true
          },
          "format": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string",
                "maxLength": 256
              },
              "minLength": {
                "type": "integer"
              },
              "maxLength": {
                "type": "integer"
              },
              "example": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "provider": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "signupUrl": {
                "type": "string",
                "format": "uri"
              },
              "docsUrl": {
                "type": "string",
                "format": "uri"
              },
              "rotateUrl": {
                "type": "string",
                "format": "uri"
              },
              "scopesNeeded": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false
          },
          "verify": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "GET",
                  "POST"
                ]
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "headerTemplate": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "expectStatus": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "default": [
                  200
                ]
              }
            },
            "required": [
              "method",
              "url",
              "headerTemplate"
            ],
            "additionalProperties": false
          },
          "sink": {
            "type": "string",
            "enum": [
              "dotenv",
              "keychain",
              "sops",
              "onepassword",
              "doppler",
              "vault",
              "external"
            ],
            "default": "dotenv"
          },
          "rotation": {
            "type": "object",
            "properties": {
              "maxAgeDays": {
                "type": "integer"
              }
            },
            "required": [
              "maxAgeDays"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "key",
          "description"
        ],
        "additionalProperties": false
      },
      "default": []
    }
  },
  "required": [
    "version"
  ],
  "additionalProperties": false
}
